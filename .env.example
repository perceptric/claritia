# Supabase: Project Settings → API Keys
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The runner and the webhooks (mail, Stripe) need this. Never expose it to the browser.
# SUPABASE_SERVICE_ROLE_KEY (the older name) works too.
SUPABASE_SECRET_KEY=sb_secret_...

# Seals environment secrets (test passwords, API keys) before they're saved.
# 32 or more random characters. Never change it once secrets are saved, or they can't be opened.
SECRETS_KEY=

# The meeting's own booking page inside forms after the send (docs/ending-plan.md Part 4): workspace ids with commas
# between, or all. Unset, forms show their own calendar.
# FORM_BOOK_PAGE=

# Amazon SES next to Resend (docs/ses-plan.md). EMAIL_SES_DOMAINS: From domains that send through SES
# (tryclaritia.com, a list, or all); empty keeps everything on Resend.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_REGION=us-east-2
# SES_CONFIGURATION_SET=claritia
# SES_SNS_TOPIC_ARN=
# EMAIL_SES_DOMAINS=
# EMAIL_SES_MOVE=1 makes new customer domains on SES and offers the move in Settings › Sending.
# EMAIL_SES_MOVE=

# Optional: the domains the proxy splits between the site and the app.
# SITE_HOST=tryclaritia.com
# APP_HOST=app.tryclaritia.com

# Link domains (docs/sharing-plan.md step 4). 1 serves <workspace>.tryclaritia.com once the wildcard DNS and
# certificate are set. A Fly token lets custom domains get their certificates.
# LINK_SUBDOMAINS=1
# FLY_API_TOKEN=
# FLY_APP_NAME=claritia-web
# LINK_DOMAIN_TARGET=claritia-web.fly.dev

# Test inboxes: a Resend API key with full access (it reads received mail), and the domain the inboxes use.
RESEND_API_KEY=
# INBOX_DOMAIN=inbox.tryclaritia.com

# Billing: the Stripe secret key. Prices, the webhook and the billing page are set up by the app.
STRIPE_SECRET_KEY=

# GitHub App (checks on pull requests). See docs/github.md.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Alerts by email go out through Resend (RESEND_API_KEY above) from this address. tryclaritia.com must be verified for sending.
# ALERTS_FROM=Claritia <alerts@tryclaritia.com>
