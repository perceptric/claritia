{
  "label": "Claritia meeting.booked",
  "type": "dedicated",
  "connection": "claritia",
  "parameters": [],
  "attach": {
    "url": "/hooks",
    "method": "POST",
    "body": {
      "url": "{{webhook.url}}",
      "event": "meeting.booked",
      "description": "Make"
    },
    "response": {
      "data": {
        "externalHookId": "{{body.id}}"
      }
    }
  },
  "detach": {
    "url": "/hooks/{{webhook.externalHookId}}",
    "method": "DELETE"
  },
  "communication": {
    "output": "{{body.data.meeting}}"
  }
}
